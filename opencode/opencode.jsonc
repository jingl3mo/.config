{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "default_agent": "plan",
  "permission": {
    "edit": "ask",
    "webfetch": "deny",
    "websearch": "allow",
    "external_directory": "ask",
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "git push *": "deny",
      "rmdir *": "ask"
    }
  }
}
